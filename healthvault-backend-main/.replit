modules = ["python-3.11"]

entrypoint = "backend/main.py"

run = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000"

[nix]

channel = "stable-25_05"

packages = [
  "cargo",
  "hdf5",
  "libiconv",
  "libpng",
  "libjpeg_turbo",
  "libxcrypt",
  "openssl",
  "pkg-config",
  "postgresql",
  "rustc",
  "which",
]

[agent]

expertMode = true

[[ports]]

localPort = 8000

externalPort = 80

[workflows]

runButton = "HealthVault Backend"

[[workflows.workflow]]

name = "HealthVault Backend"

mode = "sequential"

[[workflows.workflow.tasks]]

task = "shell.exec"

args = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000"

[deployment]

deploymentTarget = "autoscale"

run = ["sh", "-c", "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000"]
