# HealthVault AI Backend Environment Configuration

# Runtime Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Database URL:
# Local SQLite: sqlite:///./healthvault.db
# Supabase Postgres: postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./healthvault.db

# Qdrant Vector DB Settings:
# Local disk: Leave QDRANT_HOST and QDRANT_URL empty (uses backend/qdrant_db)
# Qdrant Cloud: Set QDRANT_URL and QDRANT_API_KEY
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key-here

# Firebase Authentication (Obtained from Firebase Console Service Account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# Storage Settings
STORAGE_DIR=backend/storage

# Supabase Cloud Storage (Private Bucket & Signed URLs)
# IMPORTANT: Never expose SUPABASE_SERVICE_ROLE_KEY to frontend clients!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_STORAGE_BUCKET=healthvault-medical-documents
SIGNED_URL_EXPIRY_SECONDS=300

# CORS Frontend Allowed Origin
FRONTEND_URL=https://healthvault-frontend-seven.vercel.app
DOCTOR_ALLOWED_EMAIL_DOMAINS=demo.health,hospital.org,healthvault.com,doctor.com
